# Cloudflare R2 credentials for scripts/r2-sync.mjs.
# Copy to .env (gitignored) and fill in. In Cloudflare Pages, set the same
# variables under Settings → Environment variables instead.

# Cloudflare dashboard → R2 → the account ID shown in the sidebar
R2_ACCOUNT_ID=

# R2 → Manage API Tokens → Create token, scoped "Object Read & Write" to this
# bucket only. The secret is shown exactly once.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

R2_BUCKET=

# The bucket's custom domain (R2 → bucket → Settings → Custom Domains).
# Must match `baseUrl` for the r2-images plugin in quartz.config.yaml.
R2_PUBLIC_BASE_URL=https://cdn.lonerapier.me

# Optional. Objects are immutable-cached because the plugin appends ?v=<hash>.
# R2_CACHE_CONTROL=public, max-age=31536000, immutable
