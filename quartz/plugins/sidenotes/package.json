{
  "name": "@lonerapier/quartz-sidenotes",
  "version": "0.1.0",
  "description": "Quartz transformer that renders GFM footnotes as sidenotes",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@quartz-community/types": "*"
  },
  "quartz": {
    "name": "sidenotes",
    "displayName": "Sidenotes",
    "category": "transformer",
    "version": "0.1.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 41,
    "defaultEnabled": true
  }
}
